{
  "name": "@dannyman/use-store",
  "version": "3.0.0",
  "description": "Minimal React hooks for state persisted in localStorage or sessionStorage.",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "jsnext:main": "dist/index.es.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist/",
    "build": "rollup -c && tsc -d --emitDeclarationOnly --noEmit false --declarationDir dist",
    "dev": "nodemon",
    "example": "npm run build && npm run dev --prefix=./example/",
    "test": "npm run build && npm test --prefix=./example/"
  },
  "repository": "danny-fallas/use-store-react",
  "keywords": [
    "react",
    "localstorage",
    "sessionstorage",
    "persisted-state",
    "hooks",
    "useState"
  ],
  "author": "Danny Fallas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danny-fallas/use-store-react/issues"
  },
  "homepage": "https://github.com/danny-fallas/use-store-react#readme",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^19.3.0",
    "nodemon": "3.1.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.3",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
