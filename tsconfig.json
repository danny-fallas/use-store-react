{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2020",
        "lib": [
            "es2020",
            "dom",
            "dom.iterable"
        ],
        "rootDir": "src",
        "sourceMap": true,
        "allowJs": false,
        "jsx": "preserve",
        "moduleResolution": "bundler",
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": false,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "resolveJsonModule": true,
        "isolatedModules": false,
        "noEmit": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "build",
        "dist",
        "example",
        "rollup.config.mjs"
    ]
}